/docs/sql/async_udfs /docs/udfs/rust/async-udfs 301
/docs/deployment/ec2 /docs/deployment/vm 301
/docs/sql/udfs /docs/udfs 301
/docs/sql/udafs /docs/udfs/rust/udafs 301
/docs/sql/async-udfs /docs/udfs/rust/async-udfs 301

# Section landing pages: old /overview paths now redirect to clean section URLs
