{
  "name": "arroyo-docs",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/transform-openapi.js && astro dev",
    "start": "node scripts/transform-openapi.js && astro dev",
    "build": "node scripts/transform-openapi.js && astro build",
    "build:api": "node scripts/transform-openapi.js",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "node scripts/transform-openapi.js && astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "node scripts/transform-openapi.js && astro check && astro build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.20.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "@resvg/resvg-js": "^2.6.2",
    "@scalar/openapi-parser": "0.28.12",
    "astro": "7.4.2",
    "clsx": "^2.1.1",
    "openapi-sampler": "1.7.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.17.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.95.0"
  }
